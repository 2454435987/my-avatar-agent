# DeepSeek 官方 API 配置
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_API_KEY="sk-your-deepseek-api-key"
DEEPSEEK_MODEL="deepseek-chat"

# 你的 GitHub 用户名
GITHUB_USERNAME="2454435987"

# 微信 PushPlus 实时推送 Token (可选)
PUSHPLUS_TOKEN=""

# 邮箱通知配置 (可选，支持 QQ 邮箱 / 163 邮箱)
EMAIL_USER="your-email@qq.com"
EMAIL_PASS="your-email-smtp-password"
EMAIL_TO="your-email@qq.com"

# 预算熔断阈值（人民币 元，防止被刷）
MAX_TOTAL_BUDGET_RMB="5.0"
MAX_DAILY_BUDGET_RMB="1.0"
